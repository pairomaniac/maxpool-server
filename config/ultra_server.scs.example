// Minimum working settings for ultra_server.exe (Maximum Pool).
//
// This file is a script that is parsed AND EXECUTED at startup, not an INI
// file. A parse error leaves everything below it undefined - watch for
// "Input was processed up to line N."

protocol    = "UDP";
port        = 35000;

// Required. This exact value identifies Maximum Pool; a wrong GUID means the
// server receives client probes and silently ignores them, and a blank one
// means it refuses to start.
game_guid   = "E6666EA0-DBB2-11D2-A771-006097C3E986";

server_name = "CHANGEME";
welcome     = "Welcome";

service_name = "ultra_server";

// Self-registration. Point this at the meta server and the game server adds
// itself to the browser at startup, asking for a one hour lease. One entry is
// enough; the stock WON hosts no longer resolve.
meta_server1 = "TCP:CHANGEME:15101";

// Directory it registers under, as /titan_root/titan_directory. Consoles query
// /CoolPool, so leave titan_root alone unless you know why you're changing it.
// titan_root      = "CoolPool";
// titan_directory = "My Room";

// 0 = WON.net filter, 1 = Beep, 2 = Comic.
// Any other value creates no filter object at all.
filter_style    = 2;
clean_word_list = "cleanwords.lst";
dirty_word_list = "dirtywords.lst";

max_players = 32;
max_games   = 8;

// Uncomment for a remote console. Password is arbitrary.
// Max 2 sessions, 60 min idle timeout.
// enableTelnet ("CHANGEME", 47807);

print ("Server \"" + server_name + "\" starting on port " + istr(port) + ".\n");
